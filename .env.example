# ==========================================
# LLM Chatbot Environment Variables
# ==========================================

# Comma-separated API key pool (at least 2 keys)
LLM_API_KEYS=your_key_1_here,your_key_2_here

# LiteLLM model string (default: gemini/gemini-2.0-flash)
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite Database connection URL
DATABASE_URL=sqlite:////data/app.db

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# Enable failover simulation test hook via X-Simulate-Failure header (true/false)
ENABLE_FAILURE_SIMULATION=true

# Default system prompt for new sessions
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.

# Cache directory for LiteLLM disk cache
CACHE_DIR=/data/cache

# Request timeout in seconds for each provider call
REQUEST_TIMEOUT_SECONDS=30

# Frontend API base URL (Vite build / client)
VITE_API_BASE_URL=http://localhost:8000
